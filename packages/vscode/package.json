{
  "publisher": "antfu",
  "name": "x18n-vscode",
  "displayName": "x18n",
  "type": "module",
  "version": "0.1.11",
  "private": true,
  "description": "%description%",
  "author": "Anthony Fu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/x18n-dev/x18n#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x18n-dev/x18n.git",
    "directory": "packages/vscode"
  },
  "bugs": "https://github.com/x18n-dev/x18n/issues",
  "keywords": [
    "i18n",
    "l10n",
    "translation",
    "vue-i18n",
    "i18next"
  ],
  "categories": [
    "Other",
    "Linters"
  ],
  "main": "./dist/index.cjs",
  "icon": "res/icon.png",
  "l10n": "./l10n",
  "files": [
    "LICENSE.md",
    "README.md",
    "dist",
    "l10n",
    "package.nls*.json",
    "res/*"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "x18n.findKeyByText",
        "title": "%command.findKeyByText%",
        "category": "x18n",
        "icon": "$(search)"
      },
      {
        "command": "x18n.openUi",
        "title": "%command.openUi%",
        "category": "x18n",
        "icon": "$(window)"
      },
      {
        "command": "x18n.openKey",
        "title": "%command.openKey%",
        "category": "x18n",
        "icon": "$(link-external)"
      },
      {
        "command": "x18n.setDisplayLocale",
        "title": "%command.setDisplayLocale%",
        "category": "x18n",
        "icon": "$(globe)"
      },
      {
        "command": "x18n.setLanguage",
        "title": "%command.setLanguage%",
        "category": "x18n",
        "icon": "$(symbol-text)"
      },
      {
        "command": "x18n.editKey",
        "title": "%command.editKey%",
        "category": "x18n",
        "icon": "$(edit)"
      },
      {
        "command": "x18n.renameKeyPrefix",
        "title": "%command.renameKeyPrefix%",
        "category": "x18n"
      },
      {
        "command": "x18n.deleteKey",
        "title": "%command.deleteKey%",
        "category": "x18n",
        "icon": "$(trash)"
      },
      {
        "command": "x18n.deleteUnusedKeys",
        "title": "%command.deleteUnusedKeys%",
        "category": "x18n",
        "icon": "$(trash)"
      },
      {
        "command": "x18n.extract",
        "title": "%command.extract%",
        "category": "x18n"
      },
      {
        "command": "x18n.extractFile",
        "title": "%command.extractFile%",
        "category": "x18n"
      },
      {
        "command": "x18n.copyTranslatePrompt",
        "title": "%command.copyTranslatePrompt%",
        "category": "x18n",
        "icon": "$(copy)"
      },
      {
        "command": "x18n.translateWithAgent",
        "title": "%command.translateWithAgent%",
        "category": "x18n",
        "icon": "$(sparkle)"
      },
      {
        "command": "x18n.goToNextUsage",
        "title": "%command.goToNextUsage%",
        "category": "x18n"
      },
      {
        "command": "x18n.goToPrevUsage",
        "title": "%command.goToPrevUsage%",
        "category": "x18n"
      },
      {
        "command": "x18n.toggleInPlace",
        "title": "%command.toggleInPlace%",
        "category": "x18n",
        "icon": "$(eye)"
      },
      {
        "command": "x18n.restartServer",
        "title": "%command.restartServer%",
        "category": "x18n"
      },
      {
        "command": "x18n.migrateFromI18nAlly",
        "title": "%command.migrateFromI18nAlly%",
        "category": "x18n"
      },
      {
        "command": "x18n.showOutput",
        "title": "%command.showOutput%",
        "category": "x18n"
      },
      {
        "command": "x18n.explainProjects",
        "title": "%command.explainProjects%",
        "category": "x18n"
      },
      {
        "command": "x18n.addReview",
        "title": "%command.addReview%",
        "category": "x18n",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "x18n.replyReview",
        "title": "%command.replyReview%",
        "category": "x18n"
      },
      {
        "command": "x18n.approveReview",
        "title": "%command.approveReview%",
        "category": "x18n"
      },
      {
        "command": "x18n.requestReviewChange",
        "title": "%command.requestReviewChange%",
        "category": "x18n"
      },
      {
        "command": "x18n.suggestReview",
        "title": "%command.suggestReview%",
        "category": "x18n"
      },
      {
        "command": "x18n.resolveReviewComment",
        "title": "%command.resolveReviewComment%",
        "category": "x18n",
        "icon": "$(check)"
      },
      {
        "command": "x18n.applyReviewSuggestion",
        "title": "%command.applyReviewSuggestion%",
        "category": "x18n",
        "icon": "$(lightbulb-autofix)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "x18n.renameKeyPrefix",
          "when": "false"
        },
        {
          "command": "x18n.replyReview",
          "when": "false"
        },
        {
          "command": "x18n.approveReview",
          "when": "false"
        },
        {
          "command": "x18n.requestReviewChange",
          "when": "false"
        },
        {
          "command": "x18n.suggestReview",
          "when": "false"
        },
        {
          "command": "x18n.resolveReviewComment",
          "when": "false"
        },
        {
          "command": "x18n.applyReviewSuggestion",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "x18n.deleteUnusedKeys",
          "when": "view == x18n.usageReport",
          "group": "navigation"
        },
        {
          "command": "x18n.findKeyByText",
          "when": "view == x18n.keys",
          "group": "navigation"
        },
        {
          "command": "x18n.openUi",
          "when": "view =~ /^x18n\\./",
          "group": "navigation"
        },
        {
          "command": "x18n.setDisplayLocale",
          "when": "view =~ /^x18n\\./",
          "group": "navigation"
        },
        {
          "command": "x18n.setLanguage",
          "when": "view == x18n.currentFile",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "x18n.editKey",
          "when": "viewItem == x18n.key",
          "group": "inline"
        },
        {
          "command": "x18n.openKey",
          "when": "viewItem == x18n.key",
          "group": "inline"
        },
        {
          "command": "x18n.copyTranslatePrompt",
          "when": "viewItem == x18n.key"
        },
        {
          "command": "x18n.translateWithAgent",
          "when": "viewItem == x18n.key"
        },
        {
          "command": "x18n.deleteKey",
          "when": "viewItem == x18n.key"
        },
        {
          "command": "x18n.renameKeyPrefix",
          "when": "viewItem == x18n.prefix"
        },
        {
          "command": "x18n.addReview",
          "when": "viewItem == x18n.key"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "x18n.replyReview",
          "when": "commentController == x18n.reviews",
          "group": "inline@1"
        },
        {
          "command": "x18n.suggestReview",
          "when": "commentController == x18n.reviews",
          "group": "inline@2"
        },
        {
          "command": "x18n.requestReviewChange",
          "when": "commentController == x18n.reviews",
          "group": "inline@3"
        },
        {
          "command": "x18n.approveReview",
          "when": "commentController == x18n.reviews",
          "group": "inline@4"
        }
      ],
      "comments/comment/title": [
        {
          "command": "x18n.applyReviewSuggestion",
          "when": "commentController == x18n.reviews && comment =~ /^x18n\\.review\\.suggestion\\.open$/",
          "group": "inline"
        },
        {
          "command": "x18n.resolveReviewComment",
          "when": "commentController == x18n.reviews && comment =~ /\\.open$/",
          "group": "inline"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "x18n",
          "title": "x18n",
          "icon": "res/activitybar.svg"
        }
      ]
    },
    "views": {
      "x18n": [
        {
          "id": "x18n.currentFile",
          "name": "%view.currentFile%"
        },
        {
          "id": "x18n.progress",
          "name": "%view.progress%"
        },
        {
          "id": "x18n.keys",
          "name": "%view.keys%"
        },
        {
          "id": "x18n.usageReport",
          "name": "%view.usageReport%"
        },
        {
          "id": "x18n.reviews",
          "name": "%view.reviews%"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "x18n",
      "properties": {
        "x18n.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.enabled%"
        },
        "x18n.useLocalServer": {
          "type": "boolean",
          "default": true,
          "description": "%config.useLocalServer%"
        },
        "x18n.annotations": {
          "type": "boolean",
          "default": true,
          "description": "%config.annotations%"
        },
        "x18n.annotationInPlace": {
          "type": "boolean",
          "default": true,
          "description": "%config.annotationInPlace%"
        },
        "x18n.annotationInPlaceFullMatch": {
          "type": "boolean",
          "default": false,
          "description": "%config.annotationInPlaceFullMatch%"
        },
        "x18n.annotationMaxLength": {
          "type": "number",
          "default": 40,
          "description": "%config.annotationMaxLength%"
        },
        "x18n.language": {
          "type": "string",
          "default": "",
          "enum": ["", "en", "de", "es", "fr", "ja", "ko", "pt-br", "ru", "tr", "zh-cn", "zh-tw"],
          "enumItemLabels": ["%config.languageAuto%", "English", "Deutsch", "Español", "Français", "日本語", "한국어", "Português (Brasil)", "Русский", "Türkçe", "简体中文", "繁體中文"],
          "description": "%config.language%"
        },
        "x18n.displayLocale": {
          "type": "string",
          "default": "",
          "description": "%config.displayLocale%"
        },
        "x18n.showFlags": {
          "type": "boolean",
          "default": true,
          "description": "%config.showFlags%"
        },
        "x18n.theme.annotation": {
          "type": "string",
          "default": "",
          "description": "%config.theme.annotation%"
        },
        "x18n.theme.annotationMissing": {
          "type": "string",
          "default": "",
          "description": "%config.theme.annotationMissing%"
        },
        "x18n.theme.annotationBorder": {
          "type": "string",
          "default": "",
          "description": "%config.theme.annotationBorder%"
        },
        "x18n.theme.annotationMissingBorder": {
          "type": "string",
          "default": "",
          "description": "%config.theme.annotationMissingBorder%"
        },
        "x18n.theme.annotationInPlaceFullMatch": {
          "type": "string",
          "default": "",
          "description": "%config.theme.annotationInPlaceFullMatch%"
        },
        "x18n.codeLens": {
          "type": "boolean",
          "default": false,
          "description": "%config.codeLens%"
        },
        "x18n.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "%config.trace.server%"
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "x18n.config.json",
        "url": "https://x18n.dev/schema/config.json"
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": [
          "x18n.config.yml",
          "x18n.config.yaml"
        ],
        "url": "https://x18n.dev/schema/config.json"
      },
      {
        "fileMatch": [
          "*.x18n-plugin.yml",
          "*.x18n-plugin.yaml"
        ],
        "url": "https://x18n.dev/schema/plugin.json"
      }
    ]
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --sourcemap",
    "codegen": "vscode-ext-gen --scope x18n --locale --output src/generated/meta.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:e2e": "pnpm run build && tsx test/e2e/run.ts",
    "ext:package": "pnpm --filter @x18n/ui... run build && pnpm run build && tsx scripts/stage.ts && cd .vsce && vsce package --no-dependencies -o ../x18n.vsix",
    "ext:publish": "pnpm run ext:package && vsce publish --packagePath x18n.vsix && ovsx publish x18n.vsix"
  },
  "devDependencies": {
    "@iconify-json/circle-flags": "catalog:frontend",
    "@oxc-parser/binding-wasm32-wasip1": "catalog:deps",
    "@types/vscode": "catalog:types",
    "@vscode/test-electron": "catalog:vscode",
    "@vscode/vsce": "catalog:vscode",
    "@x18n/lsp": "workspace:*",
    "ovsx": "catalog:vscode",
    "reactive-vscode": "catalog:vscode",
    "tsx": "catalog:cli",
    "vscode-ext-gen": "catalog:vscode",
    "vscode-languageclient": "catalog:vscode",
    "vscode-languageserver": "catalog:deps",
    "vsxpub": "catalog:vscode"
  }
}
