{
  "name": "@x18n/docs",
  "type": "module",
  "private": true,
  "scripts": {
    "generate": "tsx --tsconfig ../tsconfig.json scripts/generate.ts",
    "dev": "pnpm run generate && nuxt dev",
    "docs:build": "pnpm run generate && nuxt build",
    "docs:serve": "nuxt preview",
    "lint": "comark-lint \"content/**/*.md\"",
    "i18n:checkout": "diglot checkout --cwd i18n",
    "i18n:ui": "pnpm run i18n:checkout && x18n ui",
    "i18n:status": "diglot status --cwd i18n",
    "i18n:validate": "diglot validate --cwd i18n"
  },
  "devDependencies": {
    "@diglot/cli": "catalog:docs",
    "@diglot/comark": "catalog:docs",
    "@diglot/core": "catalog:docs",
    "@diglot/store": "catalog:docs",
    "@diglot/x18n": "catalog:docs",
    "@iconify-json/bxl": "catalog:frontend",
    "@iconify-json/catppuccin": "catalog:frontend",
    "@iconify-json/circle-flags": "catalog:frontend",
    "@iconify-json/devicon": "catalog:frontend",
    "@iconify-json/logos": "catalog:frontend",
    "@iconify-json/ph": "catalog:frontend",
    "@x18n/cli": "workspace:*",
    "@x18n/core": "workspace:*",
    "comark-docs": "catalog:docs",
    "comark-linter": "catalog:docs",
    "nuxt": "catalog:build"
  }
}
